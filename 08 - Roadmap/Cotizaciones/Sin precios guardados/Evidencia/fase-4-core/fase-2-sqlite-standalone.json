  "ddl": [
    {
      "name": "quotations",
      "sql": "CREATE TABLE \"quotations\" (\"id\" TEXT NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"version\" INTEGER NOT NULL DEFAULT 1, \"created_event_id\" TEXT NULL, \"last_event_id\" TEXT NULL, \"last_server_sequence\" INTEGER NULL, \"user_id\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"issued_at_local\" INTEGER NOT NULL, \"source_sale_id\" TEXT NOT NULL, \"source_draft_event_id\" TEXT NOT NULL, \"current_sale_id\" TEXT NULL, PRIMARY KEY (\"id\"), CHECK(length(trim(user_id)) > 0 AND length(trim(device_id)) > 0), CHECK(length(trim(source_sale_id)) > 0 AND length(trim(source_draft_event_id)) > 0), CHECK(current_sale_id IS NULL OR length(trim(current_sale_id)) > 0))"
    },
    {
      "name": "quotation_items",
      "sql": "CREATE TABLE \"quotation_items\" (\"id\" TEXT NOT NULL, \"active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"active\" IN (0, 1)), \"version\" INTEGER NOT NULL DEFAULT 1, \"created_event_id\" TEXT NULL, \"last_event_id\" TEXT NULL, \"last_server_sequence\" INTEGER NULL, \"quotation_id\" TEXT NOT NULL REFERENCES quotations (id) ON DELETE RESTRICT, \"variant_id\" TEXT NOT NULL, \"product_name_snapshot\" TEXT NOT NULL, \"variant_name_snapshot\" TEXT NULL, \"sale_mode_snapshot\" TEXT NOT NULL, \"quantity\" INTEGER NULL, \"measured_quantity_atomic\" INTEGER NULL, \"sale_unit_code_snapshot\" TEXT NULL, \"sale_unit_symbol_snapshot\" TEXT NULL, \"sale_unit_atomic_factor_snapshot\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK(sort_order >= 0 AND sort_order <= 9007199254740991), CHECK((sale_mode_snapshot = 'unit' AND quantity IS NOT NULL AND quantity > 0 AND quantity <= 9007199254740991\n      AND measured_quantity_atomic IS NULL\n      AND sale_unit_code_snapshot IS NULL AND sale_unit_symbol_snapshot IS NULL AND sale_unit_atomic_factor_snapshot IS NULL)\n      OR (sale_mode_snapshot = 'measured' AND quantity IS NULL\n      AND measured_quantity_atomic IS NOT NULL AND measured_quantity_atomic > 0 AND measured_quantity_atomic <= 9007199254740991\n      AND sale_unit_atomic_factor_snapshot IS NOT NULL AND sale_unit_atomic_factor_snapshot > 0 AND sale_unit_atomic_factor_snapshot <= 9007199254740991\n      AND sale_unit_code_snapshot IS NOT NULL AND length(trim(sale_unit_code_snapshot)) > 0\n      AND sale_unit_symbol_snapshot IS NOT NULL AND length(trim(sale_unit_symbol_snapshot)) > 0)))"
    }
  ],
